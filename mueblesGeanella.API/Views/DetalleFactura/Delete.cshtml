@model mueblesGeanella.Modelos.DetalleFactura
@{
    ViewData["Title"] = "Eliminar Artículo";
}

<div class="container mt-4">
    <h2 class="text-danger">Quitar renglón</h2>
    <h3>¿Está seguro que desea remover este artículo de la factura?</h3>

    <div class="card mt-4 border-danger">
        <div class="card-body">
            <h5 class="card-title">Detalles del Artículo</h5>
            <dl class="row mt-3">
                <dt class="col-sm-3">Producto</dt>
                <dd class="col-sm-9">@Model.Producto?.Nombre</dd>

                <dt class="col-sm-3">Cantidad actual</dt>
                <dd class="col-sm-9">@Model.Cantidad unidades</dd>

                <dt class="col-sm-3">Subtotal</dt>
                <dd class="col-sm-9">@Model.Subtotal.ToString("C")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <form asp-action="Delete">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="IdDetalle" />
            <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" />
            <a asp-action="Details" asp-route-id="@Model.IdFactura" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
