@{
    ViewData["Title"] = "Iniciar Sesión - Muebles Geanella";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <style>
        body {
            background-color: #FAEDF0; 
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background-color: white;
            border-radius: 15px; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }
        .btn-muebleria {
            background-color: #D4A5A5; 
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 500;
        }
        .btn-muebleria:hover {
            background-color: #6E5755; 
            color: white;
        }
        .logo-text {
            color: #4A3E3D; 
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="text-center mb-4">
            <h2 class="logo-text">Muebles Geanella</h2>
            <p class="text-muted">Acceso al Sistema Administrativo</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center" role="alert">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label" style="color:#6E5755;">Correo electrónico</label>
                <input type="email" name="correo" class="form-control" placeholder="ejemplo@mueblesgeanella.com" required />
            </div>

            <div class="mb-4">
                <label class="form-label" style="color:#6E5755;">Contraseña</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-muebleria w-100 py-2">
                Ingresar al sistema
            </button>
        </form>
    </div>

</body>
</html>
