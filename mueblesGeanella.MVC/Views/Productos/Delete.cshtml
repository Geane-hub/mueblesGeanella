@model mueblesGeanella.Modelos.Producto

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Esta seguro que quiere eliminar esta informacion?</h3>
<div asp-validation-summary="All" class="text-danger"></div>
<div>
    <h4>mueblesGeanella.Modelos.Producto</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre
        </dt>
        <dd class = "col-sm-10">
            @Model.Nombre
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Descripcion
        </dt>
        <dd class = "col-sm-10">
            @Model.Descripcion
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            PrecioUnitario
        </dt>
        <dd class = "col-sm-10">
            @Model.PrecioUnitario
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Stock
        </dt>
        <dd class = "col-sm-10">
            @Model.Stock
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdProducto" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
