@model mueblesGeanella.Modelos.Producto

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Producto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="IdProducto" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!--Nombre-->
            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <!--Descripcion-->
            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <!--Precio unitario-->
            <div class="form-group">
                <label asp-for="PrecioUnitario" class="control-label">
                    PrecioUnitario
                </label>

                <input asp-for="PrecioUnitario"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="PrecioUnitario"
                      class="text-danger"></span>
            </div>

            <!--Stock-->
            <div class="form-group">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" inputmode="numeric" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <!--Fabricante-->
            <div class="form-group">
                <label asp-for="IdFabricante" class="control-label"></label>

                <select asp-for="IdFabricante" class="form-control" asp-items="ViewBag.idFabricante">
                    <option value="">Seleccione un fabricante</option>
                </select>

                <span asp-validation-for="IdFabricante" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Editar producto" class="btn btn-primary w-100" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
