@model IEnumerable<mueblesGeanella.Modelos.Producto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
               Descripcion
            </th>
            <th>
                PrecioUnitario
            </th>
            <th>
                Stock
            </th>
            <th>
                Fabricante
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.Nombre != null ? $"{item.Nombre}" : "Sin asignar")
            </td>
            <td>
                @(item.Descripcion != null ? $"{item.Descripcion}" : "Sin asignar")
            </td>
            <td>
                @item.PrecioUnitario
            </td>
            <td>
                @item.Stock
            </td>
            <td>
                @(item.fabricante != null ? $"{item.fabricante.Nombre}" : "Sin asignar")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdProducto">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdProducto">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdProducto">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
