@model mueblesGeanella.Modelos.DetalleFactura
@{
    ViewData["Title"] = "Editar Renglón";
}

<div class="container mt-4">
    <h2>Editar Artículo de la Factura #@Model.IdFactura</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdDetalle" />
                <input type="hidden" asp-for="IdFactura" />
                <input type="hidden" asp-for="PrecioUnitario" /> <!-- Se recalcula en backend -->

                <div class="form-group mb-3">
                    <label asp-for="IdProducto" class="control-label fw-bold">Producto</label>
                    <select asp-for="IdProducto" class="form-select" asp-items="ViewBag.IdProducto"></select>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Cantidad" class="control-label fw-bold">Cantidad</label>
                    <input asp-for="Cantidad" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Guardar Cambios y Recalcular" class="btn btn-primary" />
                    <a asp-action="Details" asp-route-id="@Model.IdFactura" class="btn btn-secondary ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
