@model IEnumerable<mueblesGeanella.Modelos.DetalleFactura>

@{
    ViewData["Title"] = "Index";
}

<h1>Detalles Factura</h1>

<table class="table">
    <thead>
        <tr>
            <th>Factura</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.IdFactura</td>
            <td>@item.Producto?.Nombre</td>
            <td>@item.Cantidad</td>
            <td>@item.PrecioUnitario.ToString("C")</td>
            <td>@item.Subtotal.ToString("C")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdDetalle">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdDetalle">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdDetalle">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
