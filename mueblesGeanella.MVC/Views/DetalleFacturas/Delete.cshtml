@model IEnumerable<mueblesGeanella.Modelos.DetalleFactura>
@{
    ViewData["Title"] = "Listado Global de Detalles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado Global de Renglones Vendidos</h2>
        <a asp-controller="Facturas" asp-action="Index" class="btn btn-primary">Ir a Facturas</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3"># Factura</th>
                        <th>Producto</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio Unit.</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-center pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay renglones de detalles registrados aún.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">Factura @item.IdFactura</td>
                            <td>@item.Producto?.Nombre</td>
                            <td class="text-center">@item.Cantidad</td>
                            <td class="text-end">@item.PrecioUnitario.ToString("C")</td>
                            <td class="text-end fw-bold">@item.Subtotal.ToString("C")</td>
                            <td class="text-center pe-3">
                                <!-- Redirige a los detalles de la factura a la que pertenece este renglón -->
                                <a asp-action="Details" asp-route-id="@item.IdFactura" class="btn btn-sm btn-info text-white">Ver Factura Completa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
