@model mueblesGeanella.Modelos.DetalleFactura

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>DetalleFactura</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!--Cantidad-->
            <div class="form-group">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control"inputmode="numeric"/>
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <!--Precio-->
            <div class="form-group">
                <label asp-for="PrecioUnitario" class="control-label">
                    Precio
                </label>

                <input asp-for="PrecioUnitario"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="PrecioUnitario"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdFactura" class="control-label"></label>
                <input asp-for="IdFactura" class="form-control" />
                <span asp-validation-for="IdFactura" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Factura" class="control-label"></label>
                <input asp-for="Factura" class="form-control" />
                <span asp-validation-for="Factura" class="text-danger"></span>
            </div>

            <!--Producto-->
            <div class="form-group">
                <label asp-for="Producto" class="control-label"></label>

                <select asp-for="Producto" class="form-control" asp-items="ViewBag.IdProducto">
                    <option value="">Seleccione un producto</option>
                </select>

                <span asp-validation-for="Producto" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
