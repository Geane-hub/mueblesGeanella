@model mueblesGeanella.Modelos.Factura

@{
    ViewData["Editar factura"] = "Edit";
}

<h1>Edit</h1>

<h4>Factura</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdFactura" />

            <!--fecha-->
            <div class="form-group">
                <label asp-for="Fecha" class="control-label"></label>
                <input asp-for="Fecha" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <!--MontoTotal-->
            <div class="form-group">
                <label asp-for="MontoTotal" class="control-label">
                    PrecioUnitario
                </label>

                <input asp-for="MontoTotal"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="MontoTotal"
                      class="text-danger"></span>
            </div>

            <!--cliente-->
            <div class="form-group">
                <label asp-for="cliente" class="control-label"></label>

                <select asp-for="cliente" class="form-control" asp-items="ViewBag.IdCliente">
                    <option value="">Seleccione un cliente</option>
                </select>

                <span asp-validation-for="cliente" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
