@model mueblesGeanella.Modelos.Factura

@{
    ViewData["Borrar una factura"] = "Delete";
}

<h1>Delete</h1>

<h3>Esta seguro que quiere elimar?</h3>
<div>
    <h4>Esta Factura</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Fecha
        </dt>
        <dd class = "col-sm-10">
            @Model.Fecha
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            MontoTotal
        </dt>
        <dd class = "col-sm-10">
            @Model.MontoTotal
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Cliente
        </dt>
        <dd class = "col-sm-10">
            @Model.cliente
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdFactura" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
