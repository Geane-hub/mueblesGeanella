@model mueblesGeanella.Modelos.Factura

@{
    ViewData["Detalles de la factura"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Factura</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Fecha
        </dt>
        <dd class = "col-sm-10">
            @Model.Fecha
        </dd>
    </dl>
        <dt class = "col-sm-2">
            MontoTotal
        </dt>
        <dd class = "col-sm-10">
            @Model.MontoTotal
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Cliente
        </dt>
        <dd class = "col-sm-10">
            @Model.cliente
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdFactura">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
