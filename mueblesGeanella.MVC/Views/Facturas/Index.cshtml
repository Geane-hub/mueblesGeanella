@model IEnumerable<mueblesGeanella.Modelos.Factura>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Fecha
            </th>
            <th>
                MontoTotal
            </th>
            <th>
                Nombre_Producto
            </th>
            <th>
                Nombre_Cliente
            </th>
            <th>
                Apellido_Cliente
            </th>
            <th>
                Cedula_Cliente
            </th>
            <th>
                Correo_Cliente
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Fecha
            </td>
            <td>
                @item.MontoTotal
            </td>
                <td>
                    @(item.DetalleFacturas != null ? $"{item.DetalleFacturas}" : "Sin Asignar")
                </td>
            <td>
                @(item.cliente != null ? $"{item.cliente.Nombre}":"Sin Asignar")
            </td>
            <td>
                 @(item.cliente != null ? $"{item.cliente.Apellido}" : "Sin Asignar")
            </td>
                <td>
                    @(item.cliente != null ? $"{item.cliente.Cedula}" : "Sin Asignar")
                </td>
                <td>
                    @(item.cliente != null ? $"{item.cliente.email}" : "Sin Asignar")
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdFactura">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdFactura">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdFactura">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
