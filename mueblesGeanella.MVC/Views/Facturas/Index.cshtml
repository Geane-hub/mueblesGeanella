@model IEnumerable<mueblesGeanella.MVC.Controllers.FacturaViewModel>

@{
    ViewData["Title"] = "Facturas";
}

<h1>Facturas</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Monto Total</th>
            <th>Nombre Producto</th>
            <th>Nombre Cliente</th>
            <th>Apellido Cliente</th>
            <th>Cédula Cliente</th>
            <th>Correo Cliente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Factura.Fecha</td>
                <td>@item.Factura.MontoTotal</td>
                <td>@(item.Producto != null ? $"{item.Producto.Nombre}" : "Sin Asignar")</td>
                <td>@(item.Cliente != null ? $"{item.Cliente.Nombre}" : "Sin Asignar")</td>
                <td>@(item.Cliente != null ? $"{item.Cliente.Apellido}" : "Sin Asignar")</td>
                <td>@(item.Cliente != null ? $"{item.Cliente.Cedula}" : "Sin Asignar")</td>
                <td>@(item.Cliente != null ? $"{item.Cliente.email}" : "Sin Asignar")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Factura.IdFactura">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Factura.IdFactura">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Factura.IdFactura">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
