@model IEnumerable<mueblesGeanella.Modelos.Fabricante>

@{
    ViewData["Fabricante"] = "Fabricante";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th>
                Apellido
            </th>
            <th>
                Servicio
            </th>
            <th>
                Telefono
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Nombre
            </td>
            <td>
                @item.Apellido
            </td>
            <td>
                @item.Servicio
            </td>
            <td>
                @item.Telefono
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdFabricante">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdFabricante">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdFabricante">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
