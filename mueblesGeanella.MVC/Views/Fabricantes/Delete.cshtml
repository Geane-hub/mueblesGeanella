@model mueblesGeanella.Modelos.Fabricante

@{
    ViewData["Eliminar a un colaborador"] = "Delete";
}

<h1>Delete</h1>

<h3>Esa seguro que quiere eliminarlo?</h3>
<div>
    <h4>mueblesGeanella.Modelos.Fabricante</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre
        </dt>
        <dd class = "col-sm-10">
            @Model.Nombre
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
           Apellido
        </dt>
        <dd class = "col-sm-10">
            @Model.Apellido
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Servicio
        </dt>
        <dd class = "col-sm-10">
            @Model.Servicio
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
           Telefono
        </dt>
        <dd class = "col-sm-10">
            @Model.Telefono
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdFabricante" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
