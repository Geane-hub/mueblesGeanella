@model mueblesGeanella.Modelos.Fabricante

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Fabricante</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Nombre
        </dt>
        <dd class="col-sm-10">
            @Model.Nombre
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Apellido
        </dt>
        <dd class="col-sm-10">
            @Model.Apellido
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Servicio
        </dt>
        <dd class="col-sm-10">
            @Model.Servicio
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Telefono
        </dt>
        <dd class="col-sm-10">
            @Model.Telefono
        </dd>
    </dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdFabricante">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
